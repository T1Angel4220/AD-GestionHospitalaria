# ==========================================
# HospitalApp - Git Ignore Configuration
# ==========================================

# Environment variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
*.env
*.env.local
env.local
*.local
!*.env.sample
!*.env.example
!env.example
!*.sample

# Compressed & archive files (Keep repo clean for portfolio)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso

# Operating System files & artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data & PIDs
pids/
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Build and distribution directories
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.temp/
.parcel-cache/

# Testing & Coverage
coverage/
*.lcov
.nyc_output/
lib-cov/

# IDE & Editor configuration
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.bak
*.tmp
*.temp

# TypeScript & Linter caches
*.tsbuildinfo
.eslintcache
.stylelintcache
.node_repl_history

# Vite temporary files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
